{
  "name": "fitnes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "generate:icons": "pwa-assets-generator -r public -p minimal -o favicon.svg",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "tsc -b --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run test",
    "fix": "npm run lint:fix && npm run format",
    "nes:proof": "node tools/nes-hardware/cli.ts",
    "art:corridor": "node tools/build-corridor-art.ts",
    "nes:rom": "node tools/nes-hardware/rom-cli.ts",
    "nes:emulate": "node tools/nes-hardware/emulate.ts",
    "nes:emulator:setup": "node tools/nes-hardware/setup-emulator.ts",
    "build:preview": "tsc -b && vite build --mode preview"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "arktype": "^2.2.8",
    "dexie": "^4.4.6",
    "solid-js": "^1.9.17",
    "workbox-precaching": "^7.4.1"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@biomejs/biome": "^2.5.15",
    "@solidjs/testing-library": "^0.8.10",
    "@types/node": "^26.6.5",
    "@vite-pwa/assets-generator": "^2.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "koffi": "3.3.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.3"
  }
}
